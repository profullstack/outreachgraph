{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/api.Dockerfile",
    "//": "watchPatterns must list every path the image actually copies. Under-listing them means a merged fix sits undeployed with nothing to say so.",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "migrations/**",
      "docker/api.Dockerfile",
      "package.json",
      "bun.lock"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
