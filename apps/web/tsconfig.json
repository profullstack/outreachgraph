{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["react", "react-dom"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@outreachgraph/domain": ["../../packages/domain/src/index.ts"],
      "@outreachgraph/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "//": "Tests are excluded because they import `bun:test`, which the Next type environment has no types for. They are still typechecked by the root config, which does.",
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
