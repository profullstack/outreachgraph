{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/web.Dockerfile",
    "watchPatterns": [
      "apps/web/**",
      "packages/contracts/**",
      "packages/domain/**",
      "docker/web.Dockerfile",
      "package.json",
      "bun.lock"
    ]
  },
  "deploy": {
    "//": "/offline is pre-rendered and needs neither the API nor the database, so it is the honest liveness probe for this service.",
    "healthcheckPath": "/offline",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
