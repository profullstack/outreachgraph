{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/worker.Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "migrations/**",
      "docker/worker.Dockerfile",
      "package.json",
      "bun.lock"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "//": "One worker only. The maintenance loop is not safe to run concurrently: two replicas would both claim the same pending deletion job.",
    "numReplicas": 1
  }
}
