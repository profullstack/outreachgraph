{
  "name": "outreachgraph",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter '@outreachgraph/web' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun test",
    "db:migrate": "bun run packages/db/src/cli/migrate.ts",
    "db:status": "bun run packages/db/src/cli/migrate.ts --status",
    "db:reset": "bun run packages/db/src/cli/migrate.ts --reset",
    "start": "bun apps/server/src/index.ts",
    "dev:server": "bun --watch apps/server/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
